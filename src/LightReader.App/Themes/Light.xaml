<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#F2EEE4"/><!-- 旧书页的米黄 -->
  <SolidColorBrush x:Key="Surface" Color="#FAF8F2"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#E8E3D6"/>
  <SolidColorBrush x:Key="Canvas" Color="#E6E1D3"/>
  <SolidColorBrush x:Key="Border" Color="#D6D0C1"/>
  <SolidColorBrush x:Key="Text" Color="#173A33"/><!-- 温迪披风的深松绿 -->
  <SolidColorBrush x:Key="TextMuted" Color="#4B605A"/>
  <SolidColorBrush x:Key="TextFaint" Color="#5C6862"/>
  <SolidColorBrush x:Key="Accent" Color="#1F6F64"/><!-- 风元素的青色 -->
  <SolidColorBrush x:Key="AccentBright" Color="#5CC4B0"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#DCEDE7"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Gold" Color="#B48A3C"/><!-- 衣饰金边、花蕊 -->
  <SolidColorBrush x:Key="GoldInk" Color="#7E5B1A"/>
  <SolidColorBrush x:Key="Petal" Color="#FDFCF7"/><!-- 塞西莉亚花的白瓣 -->
  <SolidColorBrush x:Key="PetalShade" Color="#D3EBE4"/>
  <SolidColorBrush x:Key="Stem" Color="#2E6B5B"/>
  <SolidColorBrush x:Key="Danger" Color="#B42318"/>
  <SolidColorBrush x:Key="Scroll" Color="#CBC4B4"/>
  <SolidColorBrush x:Key="ScrollHover" Color="#A39C8C"/>
</ResourceDictionary>
