<Window x:Class="LightReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightReader.App"
        Title="塞西莉亚的图书馆" Width="1180" Height="820" MinWidth="840" MinHeight="580"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI" FontSize="13.5" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave"
        Closing="OnClosing" PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnWheel" StateChanged="OnStateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TabItem" TargetType="ListBoxItem">
      <Setter Property="MaxWidth" Value="230"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Height="34" Padding="10,0,4,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Separator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>
    <!-- 搜索框只留一条下划线 -->
    <Style x:Key="UnderlineBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Text}" BorderThickness="0,0,0,1.5">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 最近文件的文件名和箭头：悬停时右移、旋转 -->
    <Style x:Key="RowName" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="8" Duration="0:0:0.4"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowArrow" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="45" Duration="0:0:0.4"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowNumber" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
      <Setter Property="FontFamily" Value="{StaticResource LatinFont}"/>
      <Setter Property="FontStyle" Value="Italic"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowWhen" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
      <Setter Property="FontFamily" Value="{StaticResource LatinFont}"/>
      <Setter Property="FontStyle" Value="Italic"/>
      <Setter Property="Foreground" Value="{DynamicResource GoldInk}"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Root">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- 标题栏：花朵标志、文档标签、常用入口、窗口按钮 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="22" Height="22" Margin="14,0,10,0" VerticalAlignment="Center">
          <Canvas Width="100" Height="100">
            <Path Fill="{DynamicResource Petal}" Stroke="{DynamicResource Text}" StrokeThickness="4" StrokeLineJoin="Round" Data="M50,50 C59,38 58,16 50,4 C42,16 41,38 50,50 Z M50,50 C64.2,54.9 84.8,47.1 93.7,35.8 C79.9,31.9 58.6,37.7 50,50 Z M50,50 C49.8,65 63.5,82.2 77,87.2 C76.5,72.8 64.3,54.4 50,50 Z M50,50 C35.7,54.4 23.5,72.8 23,87.2 C36.5,82.2 50.2,65 50,50 Z M50,50 C41.4,37.7 20.1,31.9 6.3,35.8 C15.2,47.1 35.8,54.9 50,50 Z"/>
            <Ellipse Canvas.Left="42" Canvas.Top="42" Width="16" Height="16" Fill="{DynamicResource Gold}"/>
          </Canvas>
        </Viewbox>
        <StackPanel x:Name="AppTitle" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="塞西莉亚的图书馆" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="15"/>
          <TextBlock Text="Cecilia's Library" Style="{StaticResource LatinText}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ListBox x:Name="Tabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource TabItem}" SelectionChanged="TabChanged" WindowChrome.IsHitTestVisibleInChrome="True">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="Transparent" MouseDown="TabMouseDown" ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}" Background="{Binding BadgeBrush}">
                  <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE8BB;" FontSize="9" Width="22" Height="22" ToolTip="关闭 (Ctrl+W)" AutomationProperties.Name="关闭" Click="CloseTab"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource PrimaryButton}" Tag="→" Content="打开" Padding="16,5" Margin="0,0,6,0" ToolTip="打开文件 (Ctrl+O)" Click="OpenDialog"/>
          <Button Style="{StaticResource IconButton}" Tag="&#xE81C;" ToolTip="最近文件" AutomationProperties.Name="最近文件" Click="ShowRecent"/>
          <Button Style="{StaticResource IconButton}" Tag="&#xEA86;" ToolTip="格式组件" AutomationProperties.Name="格式组件" Click="ShowComponents"/>
          <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Tag="&#xE770;" AutomationProperties.Name="外观" Click="CycleTheme"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Tag="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeWindow"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Tag="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化" Click="MaximizeWindow"/>
          <Button Style="{StaticResource CaptionCloseButton}" Tag="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseWindow"/>
        </StackPanel>
      </Grid>

      <!-- 工具栏：只在打开文档时出现 -->
      <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Height="46" LastChildFill="False" Margin="10,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Style="{StaticResource IconButton}" Tag="&#xE738;" ToolTip="缩小 (Ctrl+-)" AutomationProperties.Name="缩小" Click="ZoomOut"/>
              <TextBlock x:Name="ZoomLabel" Text="100%" Width="58" Style="{StaticResource LatinText}" FontSize="19" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE710;" ToolTip="放大 (Ctrl++)" AutomationProperties.Name="放大" Click="ZoomIn"/>
              <Button Style="{StaticResource ToolButton}" Content="适合窗口" ToolTip="按窗口宽度显示 (Ctrl+0)" Click="FitView"/>
              <Border Style="{StaticResource Separator}"/>
              <Button x:Name="SearchButton" Style="{StaticResource ToolButton}" Tag="&#xE721;" Content="搜索" ToolTip="搜索 (Ctrl+F)" Click="ToggleSearch"/>
              <Button x:Name="PrintButton" Style="{StaticResource ToolButton}" Tag="&#xE749;" Content="打印" ToolTip="打印 (Ctrl+P)" Click="Print"/>
              <Button x:Name="PreciseButton" Style="{StaticResource ToolButton}" Tag="&#xE7C3;" Content="分页预览" ToolTip="按打印时的分页显示" Click="PrecisePreview" Visibility="Collapsed"/>
              <Button x:Name="pdfMode" Style="{StaticResource ToolButton}" Tag="&#xE8D2;" Content="文字与搜索" ToolTip="在页面阅读与可选中文字的视图之间切换" Click="PdfMode" Visibility="Collapsed"/>
              <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Tag="&#xE70F;" Content="编辑" Click="Edit" Visibility="Collapsed"/>
              <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Tag="&#xE792;" Content="另存为" ToolTip="另存为 (Ctrl+S)" Click="SaveAs" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="ImagePages" Orientation="Horizontal" DockPanel.Dock="Right" Visibility="Collapsed">
              <Button Style="{StaticResource IconButton}" Tag="&#xE76B;" ToolTip="上一页" AutomationProperties.Name="上一页" Click="PreviousImage"/>
              <TextBlock x:Name="ImagePageLabel" Style="{StaticResource LatinText}" FontSize="18" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="8,0"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE76C;" ToolTip="下一页" AutomationProperties.Name="下一页" Click="NextImage"/>
            </StackPanel>
            <ContentControl x:Name="ViewerTools" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"/>
          </DockPanel>
          <Border x:Name="SearchPanel" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="42" Margin="10,0">
              <TextBlock x:Name="SearchCount" Style="{StaticResource LatinText}" FontSize="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <TextBlock Text="查找" FontFamily="{StaticResource SerifFont}" FontSize="13" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="SearchInput" Style="{StaticResource UnderlineBox}" Width="240" Height="28" KeyDown="SearchKeyDown" TextChanged="SearchTextChanged"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE70E;" FontSize="12" ToolTip="上一个 (Shift+Enter)" AutomationProperties.Name="上一个" Click="FindPrevious"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE70D;" FontSize="12" ToolTip="下一个 (Enter)" AutomationProperties.Name="下一个" Click="FindNext"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE8BB;" FontSize="10" ToolTip="关闭搜索 (Esc)" AutomationProperties.Name="关闭搜索" Click="ToggleSearch"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 内容区 -->
      <Grid Grid.Row="2" Background="{DynamicResource Canvas}">
        <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto" Focusable="False" Background="{DynamicResource Bg}">
          <StackPanel Margin="0,18,0,32">
            <StackPanel MaxWidth="1180" Margin="56,0">
              <!-- 页眉：编号与说明 -->
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetaText}" Text="文档只在这台电脑上处理" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource LatinText}" FontSize="16" Margin="14,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource LatinText}" FontSize="16" Text="No. 01" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MetaText}" Text="首页" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <!-- 标题与拱形拖放区 -->
              <Grid Margin="0,26,0,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="0.8*" MaxWidth="400"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="The Library of Cecilia" Style="{StaticResource LatinText}" FontSize="21" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="塞西莉亚的" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="64" LineStackingStrategy="BlockLineHeight" LineHeight="76" Margin="0,8,0,0"/>
                  <Grid HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleWord" Text="图书馆" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="64" LineStackingStrategy="BlockLineHeight" LineHeight="76"/>
                    <Path Data="M4,14 C60,2 120,24 180,11 S262,3 296,12" Stretch="Fill" Width="{Binding ActualWidth, ElementName=TitleWord}" Height="16" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-4,0,0,-10" Stroke="{DynamicResource AccentBright}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                  <TextBlock Text="打开文档，安心阅读。双击文件、拖进窗口或者选择文件都可以，文档只在这台电脑上处理。" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left" FontSize="15" LineHeight="28" Foreground="{DynamicResource TextMuted}" Margin="0,24,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Tag="→" Content="选择文件" FontSize="16" Padding="28,12" Margin="0" Click="OpenDialog"/>
                    <TextBlock Text="或者按" FontSize="13" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="18,0,2,0"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource TextMuted}"/></Border>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="O" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource TextMuted}"/></Border>
                  </StackPanel>
                </StackPanel>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                  <local:HomeArt/>
                </Viewbox>
              </Grid>
            </StackPanel>

            <local:FormatRibbon/>

            <StackPanel x:Name="RecentHeader" MaxWidth="1180" Margin="56,30,56,0">
              <DockPanel Margin="0,0,0,12">
                <Button Style="{StaticResource LinkButton}" Content="清除记录" FontSize="14" DockPanel.Dock="Right" Click="ClearRecent"/>
                <TextBlock Text="最近打开" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="22" VerticalAlignment="Center"/>
                <TextBlock Text="Recently opened" Style="{StaticResource LatinText}" FontSize="17" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <Border BorderBrush="{DynamicResource Text}" BorderThickness="0,1,0,0">
                <ItemsControl x:Name="RecentList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource RowButton}" Height="60" Click="OpenRecent" ToolTip="{Binding Path}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="30"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" Style="{StaticResource RowNumber}" FontSize="28" VerticalAlignment="Center"/>
                          <Border Grid.Column="1" CornerRadius="99" Background="{Binding BadgeBrush}" Padding="9,2,9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10.5" FontWeight="Bold" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource RowName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock Grid.Column="3" Text="{Binding Folder}" Style="{StaticResource RowText}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding When}" Style="{StaticResource RowWhen}" FontSize="17" TextAlignment="Right" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="5" Text="↗" Style="{StaticResource RowArrow}" FontFamily="{StaticResource LatinFont}" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                          </TextBlock>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="Viewer" Visibility="Collapsed" Focusable="False"/>

        <Border x:Name="MessagePanel" Background="{DynamicResource Bg}" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420" MaxWidth="620">
            <TextBlock x:Name="MessageTitle" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="26" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="MessageDetail" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" Margin="0,12,0,0" Foreground="{DynamicResource TextMuted}"/>
            <ProgressBar x:Name="Progress" Margin="0,26,0,0" Width="320" IsIndeterminate="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
              <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Tag="→" Content="安装组件" Padding="22,9" Click="RunAction"/>
              <Button x:Name="CancelButton" Content="取消" Padding="22,8" Click="CancelWork"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="ComponentPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False" Background="{DynamicResource Bg}">
          <StackPanel MaxWidth="1080" Margin="56,18,56,32">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaText}" Text="装好后可以离线使用" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource LatinText}" FontSize="16" Text="No. 03" VerticalAlignment="Center"/>
                  <TextBlock Style="{StaticResource MetaText}" Text="格式组件" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Button Style="{StaticResource LinkButton}" Content="← 返回首页" FontFamily="{StaticResource LatinFont}" FontStyle="Italic" FontSize="16" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Left" Click="ShowRecent"/>
                <TextBlock Text="Components" Style="{StaticResource LatinText}" FontSize="20" Foreground="{DynamicResource Accent}" Margin="0,14,0,0"/>
                <TextBlock Text="格式组件" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="52"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" MaxWidth="340">
                <TextBlock Text="需要哪类格式再安装对应组件。主程序保持小巧，装好的组件之后可以离线使用。" TextWrapping="Wrap" TextAlignment="Right" LineHeight="24" Foreground="{DynamicResource TextMuted}"/>
                <Button Content="清理预览缓存" HorizontalAlignment="Right" Margin="0,14,0,0" Click="ClearCache"/>
              </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource Text}" BorderThickness="0,1,0,0" Margin="0,26,0,0">
              <StackPanel x:Name="ComponentList"/>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="DropHint" Background="{DynamicResource Bg}" Visibility="Collapsed" IsHitTestVisible="False">
          <Grid Margin="20">
            <Rectangle RadiusX="28" RadiusY="28" Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource AccentBright}" StrokeThickness="2" StrokeDashArray="4 3"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Width="54" Height="54">
                <Canvas Width="100" Height="100">
                  <Path Fill="{DynamicResource Petal}" Stroke="{DynamicResource Text}" StrokeThickness="3" StrokeLineJoin="Round" Data="M50,50 C59,38 58,16 50,4 C42,16 41,38 50,50 Z M50,50 C64.2,54.9 84.8,47.1 93.7,35.8 C79.9,31.9 58.6,37.7 50,50 Z M50,50 C49.8,65 63.5,82.2 77,87.2 C76.5,72.8 64.3,54.4 50,50 Z M50,50 C35.7,54.4 23.5,72.8 23,87.2 C36.5,82.2 50.2,65 50,50 Z M50,50 C41.4,37.7 20.1,31.9 6.3,35.8 C15.2,47.1 35.8,54.9 50,50 Z"/>
                  <Ellipse Canvas.Left="42" Canvas.Top="42" Width="16" Height="16" Fill="{DynamicResource Gold}"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="松开鼠标，打开文件" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 状态栏 -->
      <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
        <DockPanel Margin="14,0">
          <TextBlock x:Name="FormatLabel" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
