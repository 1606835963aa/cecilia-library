<Window x:Class="LightReader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="轻阅" Width="1180" Height="820" MinWidth="840" MinHeight="580" Background="#F8FAFC" FontFamily="Microsoft YaHei UI" FontSize="14" AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnDragOver" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
<Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#2563EB" CornerRadius="10" Width="34" Height="34"><TextBlock Text="阅" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="轻阅" FontWeight="SemiBold" FontSize="21" Margin="12,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="最近文件" Click="ShowRecent"/><Button Content="组件" Click="ShowComponents"/><Button Content="打开文件" Foreground="White" Background="#2563EB" Click="OpenDialog"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ListBox x:Name="Tabs" Background="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TabChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,8" ToolTip="{Binding Path}"/><Button Content="×" Padding="7,1" Background="Transparent" Click="CloseTab"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border x:Name="Toolbar" Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,9" Visibility="Collapsed"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="−" Click="ZoomOut"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="56" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="＋" Click="ZoomIn"/><Button Content="适合窗口" Click="FitView"/><Button x:Name="SearchButton" Content="搜索" Click="ToggleSearch"/><Button x:Name="PrintButton" Content="打印" Click="Print"/><Button x:Name="PreciseButton" Content="分页预览" Click="PrecisePreview" Visibility="Collapsed"/><Button x:Name="EditButton" Content="编辑" Click="Edit" Visibility="Collapsed"/><Button x:Name="SaveButton" Content="另存为" Click="SaveAs" Visibility="Collapsed"/></StackPanel><StackPanel x:Name="ImagePages" Orientation="Horizontal" DockPanel.Dock="Right" Visibility="Collapsed"><Button Content="上一页" Click="PreviousImage"/><TextBlock x:Name="ImagePageLabel" VerticalAlignment="Center" Margin="8,0"/><Button Content="下一页" Click="NextImage"/></StackPanel></DockPanel></Border>
    <Grid Grid.Row="2">
      <Border x:Name="Welcome" Background="#F8FAFC"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"><Border Background="White" CornerRadius="24" Width="96" Height="112" BorderBrush="#CBD5E1" BorderThickness="1"><StackPanel Margin="20,25"><Border Height="8" Background="#2563EB" CornerRadius="3" Margin="0,0,0,12"/><Border Height="5" Background="#CBD5E1" CornerRadius="2" Margin="0,0,0,9"/><Border Height="5" Background="#CBD5E1" CornerRadius="2" Margin="0,0,12,9"/><Border Height="5" Background="#CBD5E1" CornerRadius="2"/></StackPanel></Border><TextBlock Text="打开，安心阅读" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,28,0,18"/><TextBlock Text="将文档拖到这里，或选择一个文件" FontSize="16" Foreground="#475569" HorizontalAlignment="Center"/><Button Content="选择文件" Click="OpenDialog" HorizontalAlignment="Center" Margin="0,26,0,0" Background="#2563EB" Foreground="White" Padding="30,12"/></StackPanel></Border>
      <ContentControl x:Name="Viewer" Visibility="Collapsed"/>
      <Border x:Name="MessagePanel" Background="White" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650"><TextBlock x:Name="MessageTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock x:Name="MessageDetail" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16" Foreground="#475569"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ActionButton" Content="安装组件" Click="RunAction" Background="#2563EB" Foreground="White"/><Button x:Name="CancelButton" Content="取消" Click="CancelWork"/></StackPanel><ProgressBar x:Name="Progress" Height="5" Margin="0,24,0,0" Width="360" IsIndeterminate="True"/></StackPanel></Border>
      <Border x:Name="RecentPanel" Background="#F8FAFC" Visibility="Collapsed" Padding="32"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="清除记录" Click="ClearRecent" DockPanel.Dock="Right"/><TextBlock Text="最近文件" FontSize="25" FontWeight="SemiBold"/></DockPanel><ListBox x:Name="RecentList" Grid.Row="1" Margin="0,24,0,0" Background="Transparent" BorderThickness="0" MouseDoubleClick="OpenRecent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,12"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <Border x:Name="ComponentPanel" Background="#F8FAFC" Visibility="Collapsed" Padding="32"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="清理预览缓存" Click="ClearCache" DockPanel.Dock="Right"/><TextBlock Text="格式组件" FontSize="25" FontWeight="SemiBold"/></DockPanel><StackPanel x:Name="ComponentList" Grid.Row="1" Margin="0,24,0,0"/></Grid></Border>
      <Border x:Name="SearchPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Background="White" Padding="10" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBox x:Name="SearchInput" Width="200" KeyDown="SearchKeyDown"/><Button Content="下一个" Click="FindNext"/><Button Content="×" Click="ToggleSearch"/></StackPanel></Border>
    </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"><DockPanel Margin="20,0"><TextBlock x:Name="Status" Text="就绪" Foreground="#475569" VerticalAlignment="Center"/><TextBlock x:Name="FormatLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#475569" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Window>
