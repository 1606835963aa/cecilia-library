<Window x:Class="LightReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="塞西莉亚的图书馆" Width="1180" Height="820" MinWidth="840" MinHeight="580"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI" FontSize="13.5" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave"
        Closing="OnClosing" PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnWheel" StateChanged="OnStateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TabItem" TargetType="ListBoxItem">
      <Setter Property="MaxWidth" Value="220"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8,8,0,0" Height="34" Padding="10,0,4,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Separator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="7,0"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Root">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- 标题栏：标志、文档标签、常用入口、窗口按钮 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="24" Height="24" CornerRadius="6" Margin="12,0,10,0" Background="{DynamicResource Accent}" VerticalAlignment="Center">
          <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="AppTitle" Grid.Column="1" Text="塞西莉亚的图书馆" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ListBox x:Name="Tabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource TabItem}" SelectionChanged="TabChanged" WindowChrome.IsHitTestVisibleInChrome="True">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="Transparent" MouseDown="TabMouseDown" ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}" Background="{Binding BadgeBrush}">
                  <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE8BB;" FontSize="9" Width="22" Height="22" ToolTip="关闭 (Ctrl+W)" AutomationProperties.Name="关闭" Click="CloseTab"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource PrimaryButton}" Tag="&#xE8E5;" Content="打开" Padding="12,5" ToolTip="打开文件 (Ctrl+O)" Click="OpenDialog"/>
          <Button Style="{StaticResource IconButton}" Tag="&#xE81C;" ToolTip="最近文件" AutomationProperties.Name="最近文件" Click="ShowRecent"/>
          <Button Style="{StaticResource IconButton}" Tag="&#xEA86;" ToolTip="格式组件" AutomationProperties.Name="格式组件" Click="ShowComponents"/>
          <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Tag="&#xE770;" AutomationProperties.Name="外观" Click="CycleTheme"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Tag="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeWindow"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Tag="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化" Click="MaximizeWindow"/>
          <Button Style="{StaticResource CaptionCloseButton}" Tag="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseWindow"/>
        </StackPanel>
      </Grid>

      <!-- 工具栏：只在打开文档时出现 -->
      <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Height="44" LastChildFill="False" Margin="10,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Style="{StaticResource IconButton}" Tag="&#xE738;" ToolTip="缩小 (Ctrl+-)" AutomationProperties.Name="缩小" Click="ZoomOut"/>
              <TextBlock x:Name="ZoomLabel" Text="100%" Width="46" VerticalAlignment="Center" TextAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE710;" ToolTip="放大 (Ctrl++)" AutomationProperties.Name="放大" Click="ZoomIn"/>
              <Button Style="{StaticResource ToolButton}" Tag="&#xE9A6;" Content="适合窗口" ToolTip="按窗口宽度显示 (Ctrl+0)" Click="FitView"/>
              <Border Style="{StaticResource Separator}"/>
              <Button x:Name="SearchButton" Style="{StaticResource ToolButton}" Tag="&#xE721;" Content="搜索" ToolTip="搜索 (Ctrl+F)" Click="ToggleSearch"/>
              <Button x:Name="PrintButton" Style="{StaticResource ToolButton}" Tag="&#xE749;" Content="打印" ToolTip="打印 (Ctrl+P)" Click="Print"/>
              <Button x:Name="PreciseButton" Style="{StaticResource ToolButton}" Tag="&#xE7C3;" Content="分页预览" ToolTip="按打印时的分页显示" Click="PrecisePreview" Visibility="Collapsed"/>
              <Button x:Name="pdfMode" Style="{StaticResource ToolButton}" Tag="&#xE8D2;" Content="文字与搜索" ToolTip="在页面阅读与可选中文字的视图之间切换" Click="PdfMode" Visibility="Collapsed"/>
              <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Tag="&#xE70F;" Content="编辑" Click="Edit" Visibility="Collapsed"/>
              <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Tag="&#xE792;" Content="另存为" ToolTip="另存为 (Ctrl+S)" Click="SaveAs" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="ImagePages" Orientation="Horizontal" DockPanel.Dock="Right" Visibility="Collapsed">
              <Button Style="{StaticResource IconButton}" Tag="&#xE76B;" ToolTip="上一页" AutomationProperties.Name="上一页" Click="PreviousImage"/>
              <TextBlock x:Name="ImagePageLabel" VerticalAlignment="Center" Margin="8,0"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE76C;" ToolTip="下一页" AutomationProperties.Name="下一页" Click="NextImage"/>
            </StackPanel>
            <ContentControl x:Name="ViewerTools" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"/>
          </DockPanel>
          <Border x:Name="SearchPanel" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="40" Margin="10,0">
              <TextBlock x:Name="SearchCount" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="SearchInput" Width="240" Height="28" KeyDown="SearchKeyDown" TextChanged="SearchTextChanged"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE70E;" FontSize="12" ToolTip="上一个 (Shift+Enter)" AutomationProperties.Name="上一个" Click="FindPrevious"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE70D;" FontSize="12" ToolTip="下一个 (Enter)" AutomationProperties.Name="下一个" Click="FindNext"/>
              <Button Style="{StaticResource IconButton}" Tag="&#xE8BB;" FontSize="10" ToolTip="关闭搜索 (Esc)" AutomationProperties.Name="关闭搜索" Click="ToggleSearch"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 内容区 -->
      <Grid Grid.Row="2" Background="{DynamicResource Canvas}">
        <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel MaxWidth="680" Margin="32,44,32,32">
            <TextBlock Text="塞西莉亚的图书馆" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="打开文档，安心阅读" FontSize="15" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,26"/>
            <Grid>
              <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Scroll}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
              <StackPanel Margin="24,30" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="把文档拖到这里，或者选择一个文件" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,18"/>
                <Button Style="{StaticResource PrimaryButton}" Content="选择文件" Padding="26,9" HorizontalAlignment="Center" Click="OpenDialog"/>
              </StackPanel>
            </Grid>
            <DockPanel x:Name="RecentHeader" Margin="0,34,0,8">
              <Button Style="{StaticResource LinkButton}" Content="清除记录" DockPanel.Dock="Right" Click="ClearRecent"/>
              <TextBlock Text="最近打开" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl x:Name="RecentList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RowButton}" Click="OpenRecent" ToolTip="{Binding Path}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border CornerRadius="8" Width="36" Height="36" Background="{Binding BadgeBrush}">
                        <TextBlock Style="{StaticResource BadgeText}" FontSize="11.5" Text="{Binding Badge}"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="Viewer" Visibility="Collapsed" Focusable="False"/>

        <Border x:Name="MessagePanel" Background="{DynamicResource Canvas}" Visibility="Collapsed">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="40,34" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420" MaxWidth="620">
            <StackPanel>
              <TextBlock x:Name="MessageTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
              <TextBlock x:Name="MessageDetail" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource TextMuted}"/>
              <ProgressBar x:Name="Progress" Margin="0,24,0,0" Width="320" IsIndeterminate="True"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Content="安装组件" Click="RunAction"/>
                <Button x:Name="CancelButton" Content="取消" Click="CancelWork"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>

        <ScrollViewer x:Name="ComponentPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
          <StackPanel MaxWidth="680" Margin="32,44,32,32">
            <DockPanel>
              <Button Content="清理预览缓存" DockPanel.Dock="Right" Click="ClearCache"/>
              <TextBlock Text="格式组件" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="需要哪类格式再安装对应组件，装好后可以离线使用" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,24"/>
            <StackPanel x:Name="ComponentList"/>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="DropHint" Background="{DynamicResource Canvas}" Visibility="Collapsed" IsHitTestVisible="False">
          <Grid Margin="20">
            <Rectangle RadiusX="14" RadiusY="14" Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="5 3"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
              <TextBlock Text="松开鼠标，打开文件" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 状态栏 -->
      <DockPanel Grid.Row="3" Margin="14,0">
        <TextBlock x:Name="FormatLabel" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="Status" Text="就绪" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
